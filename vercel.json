{
  "version": 2,
  "name": "billforge",
  "installCommand": "npm install",
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "framework": null,
  "builds": [
    { "src": "api/email.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/email", "dest": "/api/email.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
