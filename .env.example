# BillForge 100% Serverless Environment Variables
# Copy this file to .env or set in Vercel Dashboard

EXPO_PUBLIC_API_URL=https://billforge.vercel.app
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/billforge?retryWrites=true&w=majority

# Pusher Channels Real-Time Setup (Free Tier 200,000 msg/day at https://pusher.com)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap2
EXPO_PUBLIC_PUSHER_KEY=your_pusher_key
EXPO_PUBLIC_PUSHER_CLUSTER=ap2
